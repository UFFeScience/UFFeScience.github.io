{
  "name": "uffescience-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "sync:publications": "node scripts/sync-publications.mjs",
    "sync:people": "python3 scripts/sync-people.py",
    "sync:weekly": "node scripts/sync-weekly.mjs",
    "prebuild": "node scripts/prepare-static.mjs",
    "sync:github": "node scripts/sync-github.mjs",
    "format": "prettier --write app lib scripts next.config.mjs package.json README.md ../README.md ../.github ../.prettierrc.json ../compose.yml",
    "format:check": "prettier --check app lib scripts next.config.mjs package.json README.md ../README.md ../.github ../.prettierrc.json ../compose.yml",
    "format:python": "python3 -m black scripts",
    "format:python:check": "python3 -m black --check scripts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
